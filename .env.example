# ==============================================================================
# NEW CHIRAG TOURS & TRAVELS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide your actual credentials.
# NEVER commit the actual .env file with real credentials to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (MongoDB Atlas or Local Instance)
MONGODB_URI=mongodb://localhost:27017/chirag_travels

# Authentication & Security Secrets
# Generate high-entropy strings for secrets (e.g., openssl rand -base64 32)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_REFRESH_EXPIRY=7d

# Cookie Security Settings
COOKIE_SECURE=false
COOKIE_DOMAIN=

# CORS Allowed Origins (Comma-separated URLs for web applications)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Initial Admin Bootstrap (Used only by: npm run bootstrap:admin)
# Never leave these hardcoded or committed to git.
BOOTSTRAP_ADMIN_NAME=Faisal Bikanerwala
BOOTSTRAP_ADMIN_MOBILE=9876543210
BOOTSTRAP_ADMIN_EMAIL=admin@chiragtravels.com
BOOTSTRAP_ADMIN_PASSWORD=

# Managed Asset Storage (Cloudinary - Required in Phase 2 for media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public Frontend URLs (for quotation links & notifications)
ADMIN_WEB_URL=http://localhost:3000
AGENT_WEB_URL=http://localhost:3001
CUSTOMER_WEB_URL=http://localhost:3002
