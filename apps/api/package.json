{
  "name": "@chirag/api",
  "version": "1.0.0",
  "private": true,
  "description": "Central Express + TypeScript REST API for New Chirag Tours and Travels",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "bootstrap:admin": "tsx src/scripts/bootstrapAdmin.ts"
  },
  "dependencies": {
    "@chirag/pricing": "*",
    "@chirag/types": "*",
    "@chirag/utils": "*",
    "@chirag/validation": "*",
    "@google/genai": "^2.32.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "nodemailer": "^10.1.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@chirag/config": "*",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "rimraf": "^5.0.7",
    "supertest": "^7.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
