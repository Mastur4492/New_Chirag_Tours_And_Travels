{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "API_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_CUSTOMER_PORTAL_URL",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
